# {{ ansible_managed }}

#
# https://raw.githubusercontent.com/k3s-io/cluster-api-k3s/refs/heads/main/samples/openstack/k3s-template.yaml
#

---
apiVersion: bootstrap.cluster.x-k8s.io/{{cluster_api_contract}}
kind: KThreesConfigTemplate
metadata:
  name: {{cluster_name}}-md-0
  namespace: default
spec:
  template:
    spec:

---
apiVersion: cluster.x-k8s.io/{{cluster_api_contract}}
kind: Cluster
metadata:
  name: {{cluster_name}}
  namespace: default
spec:
  topology:
    class: "{{ cluster_class | replace(".", "-") }}"
    classNamespace: {{ cluster_namespace }}
    variables:
      - name: controller_flavor
        value: "{{ openstack_controlplane_flavor }}"
      - name: worker_flavor
        value: "{{ openstack_worker_flavor }}"
      - name: worker_root_disk
        value: {{ openstack_worker_rootdisk_size }}
      - name: external_id
        value: "{{ openstack_external_network_id }}"
  clusterNetwork:
    pods:
      cidrBlocks:
      - 192.168.0.0/16
    serviceDomain: cluster.local
  controlPlaneRef:
    apiVersion: controlplane.cluster.x-k8s.io/{{cluster_api_contract}}
    kind: KThreesControlPlane
    name: {{cluster_name}}-control-plane
  infrastructureRef:
    apiVersion: infrastructure.cluster.x-k8s.io/{{cluster_api_contract}}
    kind: OpenStackCluster
    name: {{cluster_name}}

---
apiVersion: cluster.x-k8s.io/{{cluster_api_contract}}
kind: MachineDeployment
metadata:
  name: {{cluster_name}}-md-0
  namespace: default
spec:
  clusterName: {{cluster_name}}
  replicas: {{cluster_workers_replicas}}
  selector:
    matchLabels: null
  template:
    spec:
      bootstrap:
        configRef:
          apiVersion: bootstrap.cluster.x-k8s.io/{{cluster_api_contract}}
          kind: KThreesConfigTemplate
          name: {{cluster_name}}-md-0
      clusterName: {{cluster_name}}
      failureDomain: {{openstack_failure_domain}}
      infrastructureRef:
        apiVersion: infrastructure.cluster.x-k8s.io/{{cluster_api_contract}}
        kind: OpenStackMachineTemplate
        name: {{cluster_name}}-md-0
      version: "{{kubernetes_release}}"

---
apiVersion: controlplane.cluster.x-k8s.io/{{cluster_api_contract}}
kind: KThreesControlPlane
metadata:
  name: {{cluster_name}}-control-plane
  namespace: default
spec:
  infrastructureTemplate:
    apiVersion: infrastructure.cluster.x-k8s.io/{{cluster_api_contract}}
    kind: OpenStackMachineTemplate
    name: {{cluster_name}}-control-plane
  replicas: 1
  version: "{{kubernetes_release_version}}"

---
apiVersion: infrastructure.cluster.x-k8s.io/{{cluster_api_contract}}
kind: OpenStackCluster
metadata:
  name: {{cluster_name}}
  namespace: default
spec:
  externalNetwork:
    id: {{openstack_external_network_id}}
  identityRef:
    cloudName: {{openstack_cloud_name}}
    name: k3s-cloud-config
  managedSecurityGroups: {}
  disablePortSecurity: true
  managedSubnets:
  - cidr: 10.6.0.0/24
    dnsNameservers:
    - 1.1.1.1

---
apiVersion: infrastructure.cluster.x-k8s.io/{{cluster_api_contract}}
kind: OpenStackMachineTemplate
metadata:
  name: {{cluster_name}}-control-plane
  namespace: default
spec:
  template:
    spec:
      flavor: {{openstack_controlplane_flavor}}
      image:
        filter:
          name: {{openstack_image_name}}
      sshKeyName: {{openstack_ssh_key_name}}

---
apiVersion: infrastructure.cluster.x-k8s.io/{{cluster_api_contract}}
kind: OpenStackMachineTemplate
metadata:
  name: {{cluster_name}}-md-0
  namespace: default
spec:
  template:
    spec:
      flavor: {{openstack_node_flavor}}
      image:
        filter:
          name: {{openstack_image_name}}
      sshKeyName: {{openstack_ssh_key_name}}
