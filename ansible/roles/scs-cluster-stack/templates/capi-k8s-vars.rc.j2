# https://raw.githubusercontent.com/canonical/cluster-api-k8s/refs/tags/v0.4.2/templates/openstack/template-variables.rc
######################################################################

# https://docs.scs.community/docs/container/components/cluster-stacks/components/cluster-stacks/providers/openstack/quickstart/
export EXP_CLUSTER_RESOURCE_SET=true
export EXP_RUNTIME_SDK=true

export GIT_ACCESS_TOKEN_B64=$(echo -n '<my-personal-access-token>' | base64 -w0)
export GIT_ORG_NAME_B64=U292ZXJlaWduQ2xvdWRTdGFjaw== # SovereignCloudStack
export GIT_PROVIDER_B64=Z2l0aHVi  # github
export GIT_REPOSITORY_NAME_B64=Y2x1c3Rlci1zdGFja3M=  # cluster-stacks

export CLUSTER_NAME="{{ cluster_name }}"
export CLUSTER_TOPOLOGY=true
export CONTROL_PLANE_MACHINE_COUNT=1
export WORKER_MACHINE_COUNT=1

export KUBECONFIG="{{ kubeconfig_path }}"

export KUBERNETES_MASTER="https://{{ kubernetes_service_host }}:{{ kubernetes_service_port }}"
export KUBERNETES_SERVICE_HOST="{{ kubernetes_service_host }}"
export KUBERNETES_SERVICE_PORT="{{ kubernetes_service_port }}"
export KUBERNETES_VERSION="v{{ kubernetes_release }}"

export OPENSTACK_BASTION_ENABLED="true"
export OPENSTACK_BASTION_MACHINE_FLAVOR="{{ openstack_bastion_machine_flavor }}"
export OPENSTACK_CLOUD="{{ openstack_cloud_name }}"
export OPENSTACK_CLOUD_CACERT_B64="Cg=="
export OPENSTACK_CLOUD_CONFIG_B64=
export OPENSTACK_CLOUD_YAML_B64=
export OPENSTACK_CONTROL_PLANE_MACHINE_FLAVOR="{{ openstack_controlplane_machine_flavor }}"
export OPENSTACK_DNS_NAMESERVERS="{{ openstack_dns_nameservers }}"
export OPENSTACK_ENABLE_APISERVER_LOADBALANCER="false"
export OPENSTACK_EXTERNAL_NETWORK_ID="{{ openstack_external_network_id }}"
export OPENSTACK_FAILURE_DOMAIN=
export OPENSTACK_IMAGE_NAME="{{ openstack_image_name }}"
export OPENSTACK_NODE_MACHINE_FLAVOR="{{ openstack_node_machine_flavor }}"
export OPENSTACK_SSH_KEY_NAME="{{ openstack_ssh_key_name }}"
