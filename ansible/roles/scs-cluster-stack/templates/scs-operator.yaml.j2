# {{ ansible_managed }}
---
clusterStackVariables:
  ociRepository: {{ cluster_oci_repo_kaas }}

controllerManager:
  rbac:
    additionalRules:
      - apiGroups:
          - "openstack.k-orc.cloud"
        resources:
          - "images"
        verbs:
          - create
          - delete
          - get
          - list
          - patch
          - update
          - watch
