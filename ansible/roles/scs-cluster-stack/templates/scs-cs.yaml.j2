apiVersion: clusterstack.x-k8s.io/v1alpha1
kind: ClusterStack
metadata:
  name: openstack-${CS_MAINVER/./-}
  namespace: "$CS_NAMESPACE"
spec:
  provider: openstack
  name: "$CS_SERIES"
  kubernetesVersion: "$CS_MAINVER"
  channel: custom
  autoSubscribe: false
  noProvider: true
  versions: $CS_VERSION
