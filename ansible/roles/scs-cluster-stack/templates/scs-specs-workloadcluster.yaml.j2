# {{ ansible_managed }}
---
apiVersion: cluster.x-k8s.io/v1beta1
kind: Cluster
metadata:
  name: {{ cluster_name }}
  namespace: {{ cluster_namespace }}
  labels:
    managed-secret: cloud-config
spec:
  clusterNetwork:
    pods:
      cidrBlocks:
        - {{ cluster_cidr_pods }}
    serviceDomain: cluster.local
    services:
      cidrBlocks:
        - {{ cluster_cidr_services }}
  topology:
    variables:
      - name: controller_flavor
        value: "SCS-2V-4-20s"
      - name: worker_flavor
        value: "SCS-2V-4"
      - name: worker_root_disk
        value: 30
      - name: external_id
        value: {{ cluster_external_network_id }}
    class: {{ cluster_class }}
    controlPlane:
      replicas: 1
    version: v{{ cluster_release_version }}
    workers:
      machineDeployments:
        - class: default-worker
          failureDomain: nova
          name: default-worker
          replicas: 3
