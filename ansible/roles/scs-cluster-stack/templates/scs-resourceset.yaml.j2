# {{ ansible_managed }}
---
apiVersion: addons.cluster.x-k8s.io/{{ cluster_api_contract_addons }}
kind: ClusterResourceSet
metadata:
  name: clouds-yaml
  namespace: {{ cluster_namespace }}
spec:
  strategy: "Reconcile"
  clusterSelector:
    matchLabels:
      managed-secret: clouds-yaml
  resources:
    - name: clouds-yaml
      kind: Secret

---
apiVersion: csctl.clusterstack.x-k8s.io/{{cluster_api_contract_clusterstack_csctl}}
config:
  clusterStackName: {{cluster_series}}
  kubernetesVersion: v{{kubernetes_release}}
  provider:
    apiVersion: openstack.csctl.clusterstack.x-k8s.io/{{cluster_api_contract_clusterstack_csctl}}
    type: openstack
